# ── Cloud LLM (Groq) ──────────────────────────────
GROQ_API_KEY=gsk_여기에_발급받은_키
# 콘솔에서 현재 제공 중인 모델명 확인 후 입력 (계정마다 다름)
GROQ_MODEL=openai/gpt-oss-120b

# ── 외부 API ──────────────────────────────────────
OPENWEATHER_API_KEY=여기에_발급받은_키
GOOGLE_PLACES_API_KEY=여기에_발급받은_키

# 외부 API 사용 email
CONTACT_EMAIL=your-id@example.com

# ── Local LLM (Ollama) ────────────────────────────
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
